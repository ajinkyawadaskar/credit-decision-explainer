# Google Gemini — powers the LangGraph reason-generation agent and DeepEval judging.
# Get a key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-here

# Model used by the agent and by DeepEval's LLM-judged metrics.
# Pinned to a concrete version, not a -latest alias: a floating tag would
# silently change the model underneath a compliance system.
# gemini-2.0-flash is retired; gemini-2.5-flash is closed to new keys.
# Both return 404 NOT_FOUND. Verify with a live call, not the list endpoint --
# models.list() returns models the key cannot actually invoke.
GEMINI_MODEL=gemini-3.6-flash
